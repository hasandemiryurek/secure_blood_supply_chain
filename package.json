{
  "name": "blood-cold-chain",
  "version": "1.0.0",
  "description": "Blockchain-based Blood Cold Chain Management System",
  "main": "index.js",
  "scripts": {
    "compile": "npx hardhat compile",
    "test": "npx hardhat test",
    "node": "npx hardhat node",
    "deploy": "npx hardhat run scripts/deploy.js --network localhost",
    "deploy:local": "npx hardhat run scripts/deploy.js --network localhost",
    "server": "node backend/server.js",
    "iot": "node iot-simulator/simulator.js",
    "dev": "concurrently \"npm run node\" \"npm run server\""
  },
  "keywords": [
    "blockchain",
    "ethereum",
    "blood-chain",
    "cold-chain",
    "iot",
    "healthcare"
  ],
  "author": "Yusuf Emre Elmali & Hasan Demiryurek",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "hardhat": "^2.19.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.4.0",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ethers": "^6.9.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "form-data": "^4.0.0",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.4"
  }
}
