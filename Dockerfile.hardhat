FROM node:18-alpine

RUN apk add --no-cache curl

WORKDIR /app

COPY package*.json ./
COPY hardhat.config.js ./

RUN npm install

COPY contracts ./contracts
COPY scripts ./scripts
COPY artifacts ./artifacts
COPY cache ./cache

EXPOSE 8545

# Create startup script - skip compilation since artifacts are pre-built
RUN echo '#!/bin/sh' > /app/start.sh && \
    echo 'npx hardhat node --hostname 0.0.0.0 &' >> /app/start.sh && \
    echo 'HARDHAT_PID=$!' >> /app/start.sh && \
    echo 'echo "Waiting for Hardhat node to start..."' >> /app/start.sh && \
    echo 'sleep 10' >> /app/start.sh && \
    echo 'npx hardhat run scripts/deploy.js --network localhost --no-compile' >> /app/start.sh && \
    echo 'echo "Deployment complete. Hardhat node running..."' >> /app/start.sh && \
    echo 'wait $HARDHAT_PID' >> /app/start.sh && \
    chmod +x /app/start.sh

# Start Hardhat node and deploy
CMD ["/app/start.sh"]
